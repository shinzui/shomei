with-compiler: ghc-9.12.4
packages:
  shomei-core
  shomei-jwt
  shomei-webauthn
  shomei-postgres
  shomei-migrations
  shomei-servant
  shomei-server
  shomei-client
  examples/embedded-servant-app
  examples/microservice-auth-stack

-- Released webauthn 0.12 admits GHC 9.12.4, crypton 1.1 and jose 0.13.
-- mori://tweag/webauthn/packages/webauthn
package webauthn
  tests: False
  benchmarks: False

-- GHC 9.12.4's directory uses time 1.14; relax only this release's time ceiling.
allow-newer:
  webauthn-0.12.0.0:time

constraints:
  crypton-x509-validation >= 1.9.1
  , time < 1.15
