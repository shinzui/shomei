with-compiler: ghc-9.12.4

packages:
    shomei-core
    shomei-jwt
    shomei-webauthn
    shomei-postgres
    shomei-migrations
    shomei-servant
    shomei-server
    shomei-client
    examples/embedded-servant-app
    examples/microservice-auth-stack

-- webauthn 0.11 does not admit this project's crypton and jose versions. Use the
-- compatible build fork recorded at:
-- mori://tweag/webauthn/repos/webauthn-shomei-fork
source-repository-package
  type: git
  location: https://github.com/shinzui/webauthn.git
  tag: c274e23a5e31aac8932bac6398b65e8bca584a99

package webauthn
  tests: False
  benchmarks: False

allow-newer:
  webauthn:*

-- allow-newer also removes webauthn's crypton-x509-validation < 1.9 ceiling.
-- Keep the solver on the first release that fixes CVE-2026-9648 (NameConstraints).
constraints:
  crypton-x509-validation >= 1.9.1
