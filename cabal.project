with-compiler: ghc-9.12.4

packages:
    shomei-core
    shomei-jwt
    shomei-webauthn
    shomei-postgres
    shomei-migrations
    shomei-servant
    shomei-server
    shomei-client
    examples/embedded-servant-app
    examples/microservice-auth-stack

-- ============================================================
-- DEPENDENCY OVERRIDES — each plan appends its own block; none rewrites another's.
-- ============================================================

-- EP-3 (persistence): both dependencies now resolve from Hackage, so there are no
-- source-repository-package pins here. codd was replaced by pg-migrate (plan 50), whose
-- six packages are all published; ephemeral-pg 0.2.2.0 is published too, superseding the
-- commit pin that previously tracked 0.2.1.0. Bounds live in shomei-migrations.cabal.
-- Removing both pins is what makes shomei-migrations and shomei-postgres publishable.

-- ============================================================
-- EP-4 (JWT): jose resolves from Hackage, so there is no source-repository-package
-- pin here. The pin tracked upstream PR #137 (crypton >= 1.1.0 + ram, replacing the
-- deprecated memory) via the sumo/hs-jose fork, because the PR head lived only on
-- refs/pull/137/head. That PR merged on 2026-06-06 and jose 0.13 was published the
-- same day carrying exactly it — the changelog records no functional change over
-- 0.12 — and 0.13 lists GHC 9.12.4 in tested-with. Removing the pin is what keeps
-- shomei-jwt, shomei-servant, and shomei-server publishable.
-- ============================================================

-- ============================================================
-- MasterPlan 2 / EP-4 (operational CLI): optparse-applicative for shomei-admin.
-- On Hackage and on the GHC 9.12.4 package set; no source-repository-package needed.
-- If a version bound blocks the solve, add an `allow-newer: optparse-applicative:base`
-- entry here and record it in EP-4's Surprises & Discoveries.
-- ============================================================

-- ============================================================
-- MasterPlan 3 / EP-1 (WebAuthn): the tweag/webauthn library is tested with
-- GHC 9.10.3 and constrains crypton < 1.1 and jose < 0.12; Shōmei builds with
-- GHC 9.12.4 and carries crypton >= 1.1.0 + jose 0.13 from Hackage. The
-- shinzui/webauthn fork (a fork of tweag/webauthn, library at repo root) carries
-- a single patch on top of upstream master that builds the library against that
-- set (memory -> ram, jose 0.13 RequiredProtection header param, SignedJWT
-- annotation, validation toEither); see EP-1 Decision Log. The fork is referenced
-- from the tweag/webauthn mori corpus. allow-newer relaxes its upper bounds.
-- ============================================================
source-repository-package
  type: git
  location: https://github.com/shinzui/webauthn.git
  tag: c274e23a5e31aac8932bac6398b65e8bca584a99

package webauthn
  tests: False
  benchmarks: False

allow-newer:
  webauthn:*

-- Relaxing webauthn's bounds above also removes its crypton-x509-validation ceiling
-- (< 1.7), leaving only its floor (>= 1.6.12) — so the solver is free to drift onto a
-- version affected by CVE-2026-9648: crypton-x509-validation before 1.9.1 does not
-- enforce X.509 NameConstraints, letting a compromised name-constrained sub-CA issue
-- certificates for names outside its permitted subtrees. 1.9.1 implements the extension
-- (crypton-certificate PR #30). The solve picks 1.9.1 today only because it is newest;
-- this constraint is what keeps it from silently sliding back.
constraints:
  crypton-x509-validation >= 1.9.1

-- ============================================================
-- EP-27 (OpenAPI): generate an OpenAPI 3.1 schema from the Servant types.
-- openapi-hs and servant-openapi-hs were git-only when EP-27 landed and were
-- pinned here by commit; both are now published on Hackage (5.0.0), so the
-- source-repository-package pins are gone and the solver resolves them like any
-- other Hackage dependency. Bounds live in shomei-servant.cabal.
-- ============================================================
