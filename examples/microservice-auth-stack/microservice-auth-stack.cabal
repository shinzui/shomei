cabal-version: 3.0
name: microservice-auth-stack
version: 0.1.0.0
synopsis:
  Demo: downstream service verifying Shōmei JWTs locally via fetched JWKS

license: MIT
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: Web, Security

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common shared
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DataKinds
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies
    TypeOperators

library
  import: warnings, shared
  hs-source-dirs: src
  exposed-modules:
    Downstream.Audit
    Downstream.Service

  -- NOTE: deliberately NO dependency on shomei-postgres. This service has no database;
  -- it verifies tokens offline using a JWKS it fetches from the auth service.
  build-depends:
    aeson,
    base >=4.18 && <5,
    bytestring,
    http-client,
    http-client-tls >=0.3.6.4 && <0.5,
    http-types,
    jose,
    servant,
    servant-server,
    shomei-core,
    shomei-jwt,
    text,
    time,
    unix >=2.8 && <2.9,
    wai,

executable example-project-service
  import: warnings, shared
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    base,
    microservice-auth-stack,
    servant-health,
    shomei-core,
    shomei-jwt,
    text,
    warp,

test-suite microservice-auth-stack-test
  import: warnings, shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    base,
    bytestring,
    directory,
    effectful,
    effectful-core,
    http-client,
    http-types,
    jose,
    microservice-auth-stack,
    servant-health,
    shomei-client,
    shomei-core,
    shomei-jwt,
    shomei-migrations:test-support,
    shomei-postgres,
    shomei-servant,
    shomei-server,
    tasty >=1.5,
    tasty-hunit,
    text,
    time,
    unix >=2.8 && <2.9,
    wai,
    warp,
